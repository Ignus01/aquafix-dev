# Copy to mobile/.env and fill in. Real values are handed over privately and
# never committed. EXPO_PUBLIC_* values are built into the app bundle.

# Supabase API URL (local: http://<laptop LAN IP>:54321; emulator: http://10.0.2.2:54321)
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PowerSync instance URL (local: the self-hosted Open Edition service)
EXPO_PUBLIC_POWERSYNC_URL=
# Sentry DSN; blank turns Sentry off
EXPO_PUBLIC_SENTRY_DSN=
# development | staging | production
APP_ENV=development
